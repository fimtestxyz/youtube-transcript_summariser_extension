{
    "wireMagic": "pb3",
    "pens": [{

    }],
    "wsWinStyles": [{

    }],
    "wpWinPositions": [{

    }],
    "events": [{
        "tStartMs": 1840,
        "dDurationMs": 2280,
        "segs": [{
            "utf8": "The stall owner is limited to eight hours here (at the stall)."
        }]
    }, {
        "tStartMs": 4520,
        "dDurationMs": 1560,
        "segs": [{
            "utf8": "They took photos and videos."
        }]
    }, {
        "tStartMs": 6080,
        "dDurationMs": 1920,
        "segs": [{
            "utf8": "It has been two penalties we have received"
        }]
    }, {
        "tStartMs": 8680,
        "dDurationMs": 1360,
        "segs": [{
            "utf8": "so that was the tipping point."
        }]
    }, {
        "tStartMs": 10040,
        "dDurationMs": 2880,
        "segs": [{
            "utf8": "We are the ones who lose money, right?"
        }]
    }, {
        "tStartMs": 13560,
        "dDurationMs": 1920,
        "segs": [{
            "utf8": "Well, we gave up."
        }]
    }, {
        "tStartMs": 15800,
        "dDurationMs": 2000,
        "segs": [{
            "utf8": "Socially conscious enterprise hawker centres (SEHCs) continue to be controversial."
        }]
    }, {
        "tStartMs": 17800,
        "dDurationMs": 2080,
        "segs": [{
            "utf8": "What difficulties do hawkers face?"
        }]
    }, {
        "tStartMs": 20280,
        "dDurationMs": 2480,
        "segs": [{
            "utf8": "Now, I think over 60% of our sales"
        }]
    }, {
        "tStartMs": 22760,
        "dDurationMs": 1280,
        "segs": [{
            "utf8": "are using the 10% Timbre (app)."
        }]
    }, {
        "tStartMs": 24040,
        "dDurationMs": 1480,
        "segs": [{
            "utf8": "Because it's all neighbours right? "
        }]
    }, {
        "tStartMs": 25520,
        "dDurationMs": 3400,
        "segs": [{
            "utf8": "And this 10% is absorbed a hundred percent by hawkers."
        }]
    }, {
        "tStartMs": 28920,
        "dDurationMs": 1840,
        "segs": [{
            "utf8": "It can reach up to hundreds of dollars a day."
        }]
    }, {
        "tStartMs": 30760,
        "dDurationMs": 2200,
        "segs": [{
            "utf8": "Sometimes I tell my parents,"
        }]
    }, {
        "tStartMs": 32960,
        "dDurationMs": 2080,
        "segs": [{
            "utf8": "Wow, many people are using this discount."
        }]
    }, {
        "tStartMs": 35040,
        "dDurationMs": 3040,
        "segs": [{
            "utf8": "They would tell me not to think like that."
        }]
    }, {
        "tStartMs": 38080,
        "dDurationMs": 2480,
        "segs": [{
            "utf8": "Because it's really is a mutual agreement."
        }]
    }, {
        "tStartMs": 43000,
        "dDurationMs": 1200,
        "segs": [{
            "utf8": "Yishun Park Hawker Centre"
        }]
    }, {
        "tStartMs": 44200,
        "dDurationMs": 3360,
        "segs": [{
            "utf8": "is a socially conscious enterprise hawker centre that started operation in 2017."
        }]
    }, {
        "tStartMs": 47560,
        "dDurationMs": 2640,
        "segs": [{
            "utf8": "It is operated by local restaurant group—Timbre."
        }]
    }, {
        "tStartMs": 50200,
        "dDurationMs": 3400,
        "segs": [{
            "utf8": "Earlier, Norman, a nasi lemak vendor at this hawker center"
        }]
    }, {
        "tStartMs": 53600,
        "dDurationMs": 1760,
        "segs": [{
            "utf8": "said in a Facebook post that"
        }]
    }, {
        "tStartMs": 55360,
        "dDurationMs": 1840,
        "segs": [{
            "utf8": "because his wife who was 40 weeks pregnant"
        }]
    }, {
        "tStartMs": 57200,
        "dDurationMs": 2720,
        "segs": [{
            "utf8": "did not appear in person at the stall as a stall owner,"
        }]
    }, {
        "tStartMs": 59920,
        "dDurationMs": 2400,
        "segs": [{
            "utf8": "they eceived a warning from the National Environment Agency."
        }]
    }, {
        "tStartMs": 62680,
        "dDurationMs": 2520,
        "segs": [{
            "utf8": "The post attracted widespread attention as soon as it was published."
        }]
    }, {
        "tStartMs": 65480,
        "dDurationMs": 3960,
        "segs": [{
            "utf8": "We have managed over the years to implement a system where"
        }]
    }, {
        "tStartMs": 69440,
        "dDurationMs": 4080,
        "segs": [{
            "utf8": "we can manage the hawker center stalls without always being here."
        }]
    }, {
        "tStartMs": 73520,
        "dDurationMs": 4320,
        "segs": [{
            "utf8": "But we are still managing the stall via CCTVs, via system and all this."
        }]
    }, {
        "tStartMs": 77840,
        "dDurationMs": 3480,
        "segs": [{
            "utf8": "We are not subletting, but the rule is being enforced as a broad brush."
        }]
    }, {
        "tStartMs": 81320,
        "dDurationMs": 1480,
        "segs": [{
            "utf8": "The main point is our business."
        }]
    }, {
        "tStartMs": 82800,
        "dDurationMs": 2640,
        "segs": [{
            "utf8": "And we should be able to manage it the best way we can."
        }]
    }, {
        "tStartMs": 86440,
        "dDurationMs": 2760,
        "segs": [{
            "utf8": "The same warning also became one of the main reasons why Zhang Yuxuan,"
        }]
    }, {
        "tStartMs": 89200,
        "dDurationMs": 1720,
        "segs": [{
            "utf8": "another stallholder at Yishun Park Hawker Centre,"
        }]
    }, {
        "tStartMs": 90920,
        "dDurationMs": 4040,
        "segs": [{
            "utf8": "reluctantly closed down after eight years in business."
        }]
    }, {
        "tStartMs": 94960,
        "dDurationMs": 1040,
        "segs": [{
            "utf8": "It's sad, really."
        }]
    }, {
        "tStartMs": 96000,
        "dDurationMs": 1760,
        "segs": [{
            "utf8": "We are not sad because we don't make money."
        }]
    }, {
        "tStartMs": 97760,
        "dDurationMs": 2000,
        "segs": [{
            "utf8": "We are sad because of our customers,"
        }]
    }, {
        "tStartMs": 99760,
        "dDurationMs": 1400,
        "segs": [{
            "utf8": "the community we have built."
        }]
    }, {
        "tStartMs": 101160,
        "dDurationMs": 2840,
        "segs": [{
            "utf8": "Many HDB flats are gradually having coffee shops."
        }]
    }, {
        "tStartMs": 104000,
        "dDurationMs": 840,
        "segs": [{
            "utf8": "Post-covid,"
        }]
    }, {
        "tStartMs": 104840,
        "dDurationMs": 3080,
        "segs": [{
            "utf8": "we felt that business has become very scattered."
        }]
    }, {
        "tStartMs": 107920,
        "dDurationMs": 2960,
        "segs": [{
            "utf8": "We started to find ways to survive."
        }]
    }, {
        "tStartMs": 112040,
        "dDurationMs": 1360,
        "segs": [{
            "utf8": "I told my partner,"
        }]
    }, {
        "tStartMs": 113400,
        "dDurationMs": 1640,
        "segs": [{
            "utf8": "there's no way, you have to manage it at the hawker centre."
        }]
    }, {
        "tStartMs": 115040,
        "dDurationMs": 2040,
        "segs": [{
            "utf8": "I'm going to look for more business"
        }]
    }, {
        "tStartMs": 117080,
        "dDurationMs": 2720,
        "segs": [{
            "utf8": "to subsidised the stall at Yishun Park Hawker Centre."
        }]
    }, {
        "tStartMs": 119800,
        "dDurationMs": 4200,
        "segs": [{
            "utf8": "So at that time the operator was tightening the restrictions."
        }]
    }, {
        "tStartMs": 124000,
        "dDurationMs": 3200,
        "segs": [{
            "utf8": "The stall owner is limited to eight hours here (at the stall)."
        }]
    }, {
        "tStartMs": 127200,
        "dDurationMs": 1600,
        "segs": [{
            "utf8": "They took photos and videos."
        }]
    }, {
        "tStartMs": 128800,
        "dDurationMs": 3400,
        "segs": [{
            "utf8": "They sent emails and physical letter saying that,"
        }]
    }, {
        "tStartMs": 132200,
        "dDurationMs": 2200,
        "segs": [{
            "utf8": "you are not there as required."
        }]
    }, {
        "tStartMs": 134400,
        "dDurationMs": 1920,
        "segs": [{
            "utf8": "It has been two penalties that we have received."
        }]
    }, {
        "tStartMs": 137040,
        "dDurationMs": 1360,
        "segs": [{
            "utf8": "So that's the tipping point."
        }]
    }, {
        "tStartMs": 138400,
        "dDurationMs": 2640,
        "segs": [{
            "utf8": "We said, forget it. We've already explained it to you."
        }]
    }, {
        "tStartMs": 141760,
        "dDurationMs": 2640,
        "segs": [{
            "utf8": "Gave you evidence that we are not subletting it to someone else."
        }]
    }, {
        "tStartMs": 144400,
        "dDurationMs": 3840,
        "segs": [{
            "utf8": "They said, \"No, sorry, this is policy. You need to follow it,"
        }]
    }, {
        "tStartMs": 148240,
        "dDurationMs": 2800,
        "segs": [{
            "utf8": "if not, just give up your stall.\""
        }]
    }, {
        "tStartMs": 151960,
        "dDurationMs": 1360,
        "segs": [{
            "utf8": "The National Environment Agency stipulates that"
        }]
    }, {
        "tStartMs": 153320,
        "dDurationMs": 1960,
        "segs": [{
            "utf8": "for every day a hawker stall operates,"
        }]
    }, {
        "tStartMs": 155280,
        "dDurationMs": 3360,
        "segs": [{
            "utf8": "the stall owner must personally attend the stall for at least half a day."
        }]
    }, {
        "tStartMs": 159400,
        "dDurationMs": 2400,
        "segs": [{
            "utf8": "This regulation applies to all hawkers,"
        }]
    }, {
        "tStartMs": 161800,
        "dDurationMs": 2440,
        "segs": [{
            "utf8": "not just targeting socially conscious enterprise hawkers."
        }]
    }, {
        "tStartMs": 164240,
        "dDurationMs": 2720,
        "segs": [{
            "utf8": "But because socially conscious enterprise hawkers are managed by different operators,"
        }]
    }, {
        "tStartMs": 166960,
        "dDurationMs": 3200,
        "segs": [{
            "utf8": "the level of rigor in monitoring may vary."
        }]
    }, {
        "tStartMs": 170600,
        "dDurationMs": 3720,
        "segs": [{
            "utf8": "Socially conscious enterprise hawker centres,"
        }]
    }, {
        "tStartMs": 174320,
        "dDurationMs": 2000,
        "segs": [{
            "utf8": "SEHC"
        }]
    }, {
        "tStartMs": 176320,
        "dDurationMs": 3760,
        "segs": [{
            "utf8": "account for 16 of the 123 hawker centres in Singapore."
        }]
    }, {
        "tStartMs": 180080,
        "dDurationMs": 5000,
        "segs": [{
            "utf8": "Unlike most hawker centres which are directly managed by the The National Environment Agency and town councils,"
        }]
    }, {
        "tStartMs": 185080,
        "dDurationMs": 4800,
        "segs": [{
            "utf8": "socially conscious enterprise hawker centres are managed by socially conscious private operators."
        }]
    }, {
        "tStartMs": 189880,
        "dDurationMs": 3160,
        "segs": [{
            "utf8": "There are currently five local operators operating."
        }]
    }, {
        "tStartMs": 193640,
        "dDurationMs": 3320,
        "segs": [{
            "utf8": "All SEHCs are required to provide affordable meal options."
        }]
    }, {
        "tStartMs": 196960,
        "dDurationMs": 2240,
        "segs": [{
            "utf8": "Some vendors also have to participate in providing diners with"
        }]
    }, {
        "tStartMs": 199200,
        "dDurationMs": 3520,
        "segs": [{
            "utf8": "loyalty program with 5% or 10% discount."
        }]
    }, {
        "tStartMs": 202720,
        "dDurationMs": 2400,
        "segs": [{
            "utf8": "All costs shall be borne by the stall owner."
        }]
    }, {
        "tStartMs": 205120,
        "dDurationMs": 2920,
        "segs": [{
            "utf8": "This regulation is also different from that of ordinary hawker centers."
        }]
    }, {
        "tStartMs": 208440,
        "dDurationMs": 1840,
        "segs": [{
            "utf8": "I can agree with some of the budget meals,"
        }]
    }, {
        "tStartMs": 210280,
        "dDurationMs": 2560,
        "segs": [{
            "utf8": "but it has to cater to specific customers."
        }]
    }, {
        "tStartMs": 212840,
        "dDurationMs": 3240,
        "segs": [{
            "utf8": "For now anybody else, anybody can buy the budget meal."
        }]
    }, {
        "tStartMs": 216080,
        "dDurationMs": 2400,
        "segs": [{
            "utf8": "Budget meals are not profitable business."
        }]
    }, {
        "tStartMs": 219960,
        "dDurationMs": 3480,
        "segs": [{
            "utf8": "You can see that our area is not very big or busy."
        }]
    }, {
        "tStartMs": 223440,
        "dDurationMs": 2560,
        "segs": [{
            "utf8": "So the 10% is a way"
        }]
    }, {
        "tStartMs": 226000,
        "dDurationMs": 3680,
        "segs": [{
            "utf8": "to attract customers to come to know Yishun Park Hawker Centre. "
        }]
    }, {
        "tStartMs": 230280,
        "dDurationMs": 2160,
        "segs": [{
            "utf8": "We want to bear the cost as a marketing cost."
        }]
    }, {
        "tStartMs": 232440,
        "dDurationMs": 920,
        "segs": [{
            "utf8": "But over the years,"
        }]
    }, {
        "tStartMs": 233360,
        "dDurationMs": 5760,
        "segs": [{
            "utf8": "we felt that more and more of this 10% is eating into our profits."
        }]
    }, {
        "tStartMs": 239120,
        "dDurationMs": 1640,
        "segs": [{
            "utf8": "Because it is an absolute cost for us."
        }]
    }, {
        "tStartMs": 240960,
        "dDurationMs": 2640,
        "segs": [{
            "utf8": "(Operator) They said no sorry, this is part of it, this is part of our programme."
        }]
    }, {
        "tStartMs": 243600,
        "dDurationMs": 1280,
        "segs": [{
            "utf8": "We will not remove it ."
        }]
    }, {
        "tStartMs": 244880,
        "dDurationMs": 2240,
        "segs": [{
            "utf8": "We will not remove it ."
        }]
    }, {
        "tStartMs": 247120,
        "dDurationMs": 3960,
        "segs": [{
            "utf8": "Naturally to survive, to get back the profit, what do we do? We put it back to the price."
        }]
    }, {
        "tStartMs": 254960,
        "dDurationMs": 3360,
        "segs": [{
            "utf8": "We have two stores both located in SEHCs."
        }]
    }, {
        "tStartMs": 258320,
        "dDurationMs": 4480,
        "segs": [{
            "utf8": "About 70 to 80% of customers use this app."
        }]
    }, {
        "tStartMs": 262800,
        "dDurationMs": 2600,
        "segs": [{
            "utf8": "So the impact is quite big."
        }]
    }, {
        "tStartMs": 265400,
        "dDurationMs": 6360,
        "segs": [{
            "utf8": "That is, about 10% of our income will be deducted."
        }]
    }, {
        "tStartMs": 272120,
        "dDurationMs": 1120,
        "segs": [{
            "utf8": "When signing the contract,"
        }]
    }, {
        "tStartMs": 273240,
        "dDurationMs": 2360,
        "segs": [{
            "utf8": "(the operator) also told us very clearly,"
        }]
    }, {
        "tStartMs": 275600,
        "dDurationMs": 3160,
        "segs": [{
            "utf8": "they will have this 10% discount."
        }]
    }, {
        "tStartMs": 278760,
        "dDurationMs": 3760,
        "segs": [{
            "utf8": "I think it's our own decision."
        }]
    }, {
        "tStartMs": 282520,
        "dDurationMs": 2520,
        "segs": [{
            "utf8": "Because it really is a mutual agreement."
        }]
    }, {
        "tStartMs": 286440,
        "dDurationMs": 2040,
        "segs": [{
            "utf8": "As on why don’t the operators and vendors"
        }]
    }, {
        "tStartMs": 288480,
        "dDurationMs": 2720,
        "segs": [{
            "utf8": "share responsibility for discounts offered to diners."
        }]
    }, {
        "tStartMs": 291560,
        "dDurationMs": 3320,
        "segs": [{
            "utf8": "Lianhe Zaobao asked the operators"
        }]
    }, {
        "tStartMs": 294880,
        "dDurationMs": 2240,
        "segs": [{
            "utf8": "Fairprice Group and Timbre+ Hawkers for an interview."
        }]
    }, {
        "tStartMs": 297520,
        "dDurationMs": 2440,
        "segs": [{
            "utf8": "But both sides did not respond."
        }]
    }, {
        "tStartMs": 300840,
        "dDurationMs": 2120,
        "segs": [{
            "utf8": "During Parliament on September 24,"
        }]
    }, {
        "tStartMs": 302960,
        "dDurationMs": 4960,
        "segs": [{
            "utf8": "The Ministry of Sustainable Development and Environment also responded to the issue of vendors bearing too much responsibility and costs."
        }]
    }, {
        "tStartMs": 308560,
        "dDurationMs": 7280,
        "segs": [{
            "utf8": "Today value meals account for 5 to 20% of a meal of the number of meals a hawker sells."
        }]
    }, {
        "tStartMs": 315840,
        "dDurationMs": 6720,
        "segs": [{
            "utf8": "So the hawkers themselves, this is not expected to result in any business losses."
        }]
    }, {
        "tStartMs": 322560,
        "dDurationMs": 4040,
        "segs": [{
            "utf8": "Loyalty program pretty much benefits all parties in this situation."
        }]
    }, {
        "tStartMs": 326600,
        "dDurationMs": 2560,
        "segs": [{
            "utf8": "It benefits the stall holders because of increased footfall"
        }]
    }, {
        "tStartMs": 329160,
        "dDurationMs": 1400,
        "segs": [{
            "utf8": "operators tend to gain as well."
        }]
    }, {
        "tStartMs": 330560,
        "dDurationMs": 2880,
        "segs": [{
            "utf8": "And of course, patrons tend to benefit from this discounts."
        }]
    }, {
        "tStartMs": 333440,
        "dDurationMs": 3480,
        "segs": [{
            "utf8": "The discounts are then borne by stall holders at the stall level,"
        }]
    }, {
        "tStartMs": 336920,
        "dDurationMs": 3000,
        "segs": [{
            "utf8": "and this will help to attract returning customers."
        }]
    }, {
        "tStartMs": 339920,
        "dDurationMs": 2520,
        "segs": [{
            "utf8": "Operators then invest in centralised systems. "
        }]
    }, {
        "tStartMs": 342440,
        "dDurationMs": 5360,
        "segs": [{
            "utf8": "So in all the cases that we have seen across SEHCs that have operated such programs,"
        }]
    }, {
        "tStartMs": 347800,
        "dDurationMs": 5280,
        "segs": [{
            "utf8": "the operators are the ones that develop and maintain these apps and publicity efforts."
        }]
    }, {
        "tStartMs": 353440,
        "dDurationMs": 2880,
        "segs": [{
            "utf8": "SEHCs have sparked controversy in recent years."
        }]
    }, {
        "tStartMs": 356680,
        "dDurationMs": 2560,
        "segs": [{
            "utf8": "Relevant government departments have also clarified in parliament"
        }]
    }, {
        "tStartMs": 359240,
        "dDurationMs": 1920,
        "segs": [{
            "utf8": "the advantages of establishing this model."
        }]
    }, {
        "tStartMs": 362120,
        "dDurationMs": 2160,
        "segs": [{
            "utf8": "This management model has many advantages."
        }]
    }, {
        "tStartMs": 364880,
        "dDurationMs": 3720,
        "segs": [{
            "utf8": "First, SEHC operator has industry knowledge and experience."
        }]
    }, {
        "tStartMs": 369080,
        "dDurationMs": 2760,
        "segs": [{
            "utf8": "They can use their expertise in the restaurant industry"
        }]
    }, {
        "tStartMs": 371840,
        "dDurationMs": 2000,
        "segs": [{
            "utf8": "to ensure the vitality of hawker centres."
        }]
    }, {
        "tStartMs": 373840,
        "dDurationMs": 4240,
        "segs": [{
            "utf8": "Second, SEHC operators can use their connections in the catering industry to"
        }]
    }, {
        "tStartMs": 378080,
        "dDurationMs": 2280,
        "segs": [{
            "utf8": "screen and attracting vendors to settle in."
        }]
    }, {
        "tStartMs": 380360,
        "dDurationMs": 4040,
        "segs": [{
            "utf8": "Third, SEHC operators can assist stall owners"
        }]
    }, {
        "tStartMs": 384400,
        "dDurationMs": 2800,
        "segs": [{
            "utf8": "to innovate and adapt to new trends in the industry."
        }]
    }, {
        "tStartMs": 389000,
        "dDurationMs": 4280,
        "segs": [{
            "utf8": "SEHC is a place for young people like me"
        }]
    }, {
        "tStartMs": 393280,
        "dDurationMs": 2680,
        "segs": [{
            "utf8": "who have never done hawker business."
        }]
    }, {
        "tStartMs": 395960,
        "dDurationMs": 3240,
        "segs": [{
            "utf8": "It'll be easier to do it there."
        }]
    }, {
        "tStartMs": 399360,
        "dDurationMs": 3480,
        "segs": [{
            "utf8": "SEHC have centralised dishwashers."
        }]
    }, {
        "tStartMs": 402840,
        "dDurationMs": 2360,
        "segs": [{
            "utf8": "Traditional hawker centers do not have that."
        }]
    }, {
        "tStartMs": 406360,
        "dDurationMs": 2840,
        "segs": [{
            "utf8": "(In traditional hawker centers), you have to handle the POS system yourself."
        }]
    }, {
        "tStartMs": 409200,
        "dDurationMs": 4240,
        "segs": [{
            "utf8": "Even washing the stall and dishes requires you to do it yourself."
        }]
    }, {
        "tStartMs": 414080,
        "dDurationMs": 2800,
        "segs": [{
            "utf8": "(Young vendors) can just focus on business."
        }]
    }, {
        "tStartMs": 416880,
        "dDurationMs": 1680,
        "segs": [{
            "utf8": "It's just a lot of bits and pieces"
        }]
    }, {
        "tStartMs": 418560,
        "dDurationMs": 1560,
        "segs": [{
            "utf8": "that they don't have to worry too much."
        }]
    }, {
        "tStartMs": 420120,
        "dDurationMs": 6080,
        "segs": [{
            "utf8": "After they have gained some experience in SEHC,"
        }]
    }, {
        "tStartMs": 426200,
        "dDurationMs": 4680,
        "segs": [{
            "utf8": "it's also a good thing to explore it yourself."
        }]
    }, {
        "tStartMs": 430880,
        "dDurationMs": 7240,
        "segs": [{
            "utf8": "Because I think the barrier to entry for traditional hawker centers is a bit high."
        }]
    }, {
        "tStartMs": 438320,
        "dDurationMs": 3760,
        "segs": [{
            "utf8": "Operators of SEHCs must fulfill their social responsibilities."
        }]
    }, {
        "tStartMs": 442080,
        "dDurationMs": 2800,
        "segs": [{
            "utf8": "According to the agreement between them and The National Environment Agency,"
        }]
    }, {
        "tStartMs": 444880,
        "dDurationMs": 3040,
        "segs": [{
            "utf8": "the operator must give at least half of the profits earned"
        }]
    }, {
        "tStartMs": 447920,
        "dDurationMs": 2560,
        "segs": [{
            "utf8": "to the re-entering of the operation of hawker centres."
        }]
    }, {
        "tStartMs": 450880,
        "dDurationMs": 2320,
        "segs": [{
            "utf8": "To be honest, yes. So they are doing their part"
        }]
    }, {
        "tStartMs": 453200,
        "dDurationMs": 2360,
        "segs": [{
            "utf8": "in trying to bring people to the market on weekends."
        }]
    }, {
        "tStartMs": 455560,
        "dDurationMs": 3800,
        "segs": [{
            "utf8": "You've seen some of the weekend markets for the children."
        }]
    }, {
        "tStartMs": 459360,
        "dDurationMs": 1880,
        "segs": [{
            "utf8": "They have marketing where"
        }]
    }, {
        "tStartMs": 461240,
        "dDurationMs": 4160,
        "segs": [{
            "utf8": "they come to our stall to shoot some videos"
        }]
    }, {
        "tStartMs": 465400,
        "dDurationMs": 3160,
        "segs": [{
            "utf8": "and put it on the screen in the hawker centre."
        }]
    }, {
        "tStartMs": 468560,
        "dDurationMs": 4440,
        "segs": [{
            "utf8": "I don't know how effective it actually is."
        }]
    }, {
        "tStartMs": 473440,
        "dDurationMs": 2800,
        "segs": [{
            "utf8": "But I saw they were trying their best."
        }]
    }, {
        "tStartMs": 477880,
        "dDurationMs": 2680,
        "segs": [{
            "utf8": "People always say, you signed the contract."
        }]
    }, {
        "tStartMs": 480560,
        "dDurationMs": 2160,
        "segs": [{
            "utf8": "Why did you sign it at that time?"
        }]
    }, {
        "tStartMs": 482720,
        "dDurationMs": 3080,
        "segs": [{
            "utf8": "Yes, let's look in a good direction."
        }]
    }, {
        "tStartMs": 485800,
        "dDurationMs": 1200,
        "segs": [{
            "utf8": "Signing this thing is not bad."
        }]
    }, {
        "tStartMs": 487000,
        "dDurationMs": 2000,
        "segs": [{
            "utf8": "Loyalty programs are cool."
        }]
    }, {
        "tStartMs": 489000,
        "dDurationMs": 2720,
        "segs": [{
            "utf8": "Paying with QR codes is really attractive."
        }]
    }, {
        "tStartMs": 491720,
        "dDurationMs": 2280,
        "segs": [{
            "utf8": "Along the way while doing it,"
        }]
    }, {
        "tStartMs": 494000,
        "dDurationMs": 2320,
        "segs": [{
            "utf8": "one year, two years, three years, four years,"
        }]
    }, {
        "tStartMs": 496320,
        "dDurationMs": 3640,
        "segs": [{
            "utf8": "I feel this thing is not ideal."
        }]
    }, {
        "tStartMs": 500120,
        "dDurationMs": 3160,
        "segs": [{
            "utf8": "We currently have 28 outlets all around Singapore."
        }]
    }, {
        "tStartMs": 503280,
        "dDurationMs": 2240,
        "segs": [{
            "utf8": "A lot of people have been asking why I don't leave"
        }]
    }, {
        "tStartMs": 505520,
        "dDurationMs": 4000,
        "segs": [{
            "utf8": "or why I, I just run away and go and privatise."
        }]
    }, {
        "tStartMs": 509520,
        "dDurationMs": 5560,
        "segs": [{
            "utf8": "I feel I have a stake and have a say as a citizen and also as a third generation hawker"
        }]
    }, {
        "tStartMs": 515080,
        "dDurationMs": 1480,
        "segs": [{
            "utf8": "to make hawkers better."
        }]
    }, {
        "tStartMs": 516560,
        "dDurationMs": 2680,
        "segs": [{
            "utf8": "Everybody want to be successful, even hawkers."
        }]
    }, {
        "tStartMs": 519240,
        "dDurationMs": 3640,
        "segs": [{
            "utf8": "So we need to make the environment more conducive"
        }]
    }, {
        "tStartMs": 522880,
        "dDurationMs": 4040,
        "segs": [{
            "utf8": "instead of being more restrictive with so much more rules."
        }]
    }]
}